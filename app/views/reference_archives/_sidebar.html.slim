aside.sidebar id="sidebar" aria-label="タグ一覧"
  .sidebar__logo
    = link_to reference_archives_path, class: "site-header__logo", data: { turbo_frame: "_top" } do
      = image_tag "logo.png", alt: "絵師ぽ"
    button.sidebar__close type="button" aria-label="メニューを閉じる" data-action="sidebar#close"
      svg(
        viewBox="0 0 24 24"
        width="22"
        height="22"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linejoin="round"
        aria-hidden="true"
      )
        rect x="3.5" y="4.5" width="17" height="15" rx="3.5"
        line x1="9.5" y1="4.5" x2="9.5" y2="19.5"
  section.sidebar__section data-controller="tag-search view-switch" data-action="tag-search:search->view-switch#searching"
    h2.sidebar__title タグでブクマを絞り込む
    label.sidebar__search-field
      svg.sidebar__search-icon(
        viewBox="0 0 24 24"
        width="15"
        height="15"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      )
        circle cx="10.5" cy="10.5" r="6.5"
        line x1="15.5" y1="15.5" x2="20" y2="20"
      input.sidebar__search type="search" placeholder="タグを検索" aria-label="タグを検索" data-tag-search-target="input" data-action="input->tag-search#search"
    .sidebar__tags
      - if tags.present?
        .sidebar__tag-groups data-view-switch-target="kanaSections"
          - group_tags_by_kana(tags).each do |kana_row, row_tags|
            section.sidebar__tag-group
              h3.sidebar__tag-group-title = kana_row
              - if row_tags.present?
                ul.sidebar__tag-group-list
                  - row_tags.each do |tag|
                    li = render "sidebar_tag", tag:, selected_tags:
              - else
                p.sidebar__empty まだタグがありません
        .sidebar__search-results data-view-switch-target="resultsSection" hidden=true
          h3.sidebar__search-results-title data-tag-search-target="matchLabel" ヒットしたタグ
          ul.sidebar__tag-group-list
            - sort_for_suggestions(tags).each do |tag|
              li data-tag-search-target="tag" data-tag-search-name=tag.name
                = render "sidebar_tag", tag:, selected_tags:
          p.sidebar__empty data-tag-search-target="emptyLabel" hidden=true ヒットするタグがありませんでした
      - else
        p.sidebar__empty まだタグがありません
  footer.sidebar__footer
    = render "layouts/account_menu"
