.sidebar id="sidebar"
  .sidebar__section
    h3.sidebar__title タグでブクマを絞り込む
    .sidebar__tags
      - if tags.present?
        - tags.each do |tag|
          = link_to "##{tag.name} (#{tag.count})",
            selected_tags_path(tag.name, current_selected_tags: selected_tags),
            class: "tag-pill sidebar__tag",
            data: { tag_name: tag.name }
      - else
        p.sidebar__empty まだタグがありません

  / TODO：へッダー作ったら位置調整
  .sidebar__section
    = button_to "ログアウト", logout_path, method: :delete, form: { data: { turbo_frame: "_top" } }
    = button_to "退会する", user_path(current_user), method: :delete,
      form: { data: { turbo_frame: "_top", turbo_confirm: "退会するとブックマークもすべて削除されます。よろしいですか？" } }
