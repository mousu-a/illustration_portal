= turbo_stream.update "flash" do
  = render "layouts/flash_content"

- if @create_reference_archive.persisted?
  - if @create_reference_archive.included_in_tag_filter?(@selected_tags)
    = turbo_stream.remove "archives_empty"
    = turbo_stream.prepend "archives_list" do
      = render "archive", archive: @create_reference_archive
    = turbo_stream.replace_all ".pagination-wrapper" do
      = render "pagination", reference_archives: @reference_archives
  = turbo_stream.replace "sidebar" do
    = render "sidebar", tags: @tags, selected_tags: @selected_tags
  = turbo_stream.replace "create_form" do
    = render "create_form", reference_archive: @create_form_reference_archive, tags: @tags

- else
  = turbo_stream.replace "create_form" do
    = render "create_form", reference_archive: @create_reference_archive, tags: @tags
