.account-menu
  button.account-menu__trigger type="button" popovertarget="account-menu" aria-label="アカウントメニュー"
    - if current_user.avatar_url.present?
      = image_tag current_user.avatar_url, alt: "", class: "account-menu__avatar"
    - else
      span.account-menu__avatar.account-menu__avatar--initial = current_user.name.to_s.first.upcase.presence || "?"
  menu.account-menu__panel.menu-panel popover="auto" id="account-menu"
    li
      = button_to "ログアウト", logout_path, method: :delete, class: "menu-item",
        form: { data: { turbo_frame: "_top" } }
    li
      = button_to "退会する", user_path(current_user), method: :delete, class: "menu-item menu-item--danger",
        form: { data: { turbo_frame: "_top", turbo_confirm: "退会するとブックマークもすべて削除されます。よろしいですか？" } }
